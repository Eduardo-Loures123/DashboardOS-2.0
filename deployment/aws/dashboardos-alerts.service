[Unit]
Description=DashboardOS deadline scan and email outbox
After=network-online.target

[Service]
Type=oneshot
User=dashboardos
Group=www-data
WorkingDirectory=/opt/dashboardos/current
EnvironmentFile=/etc/dashboardos/dashboardos.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=America/Sao_Paulo
ExecStart=/opt/dashboardos/current/.venv/bin/python -m flask --app app processar-alertas
TimeoutStartSec=600
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dashboardos
